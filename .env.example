# ---------------------------------------------------------------------------
# Copy to .env.local and fill in what you need. Everything here is optional
# except the mail provider — without one the contact form cannot deliver and
# will tell visitors to email hello@itsdeacon.com directly instead.
# ---------------------------------------------------------------------------

# Where the site lives. Used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://itsdeacon.com


# --- Contact form ----------------------------------------------------------
# Who receives enquiries, and the address they are sent from. Both already
# default to these values in code — set them only to override.
#
# The "from" domain has to be one your provider has verified; any mailbox on a
# verified domain works, and it does not need to be a real inbox. Keeping it
# separate from CONTACT_TO means a reply to a lead never appears to come from
# the form, and form traffic can be filtered on its own.
#
# Leave these UNSET unless you mean to change them — a stale CONTACT_FROM in a
# deployment silently overrides the default.
# CONTACT_TO=hello@itsdeacon.com
# CONTACT_FROM="Deacon <form@itsdeacon.com>"

# Option 1 (preferred): Resend — https://resend.com
# Verify itsdeacon.com in the dashboard, then paste the API key here.
RESEND_API_KEY=

# Option 2: any SMTP server — Fastmail, Google Workspace, Postmark, Zoho, …
# Used only when RESEND_API_KEY is unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Leave unset to infer from the port (465 = implicit TLS, 587 = STARTTLS).
SMTP_SECURE=


# --- "Check yours" screenshots ---------------------------------------------
# Most sites block being shown in an iframe, so the lookup falls back to a
# screenshot. With nothing set here it uses WordPress's free mShots service,
# which renders at desktop width — the page says so when that happens.
#
# Setting either key below gets a true 375px phone-width capture.
SCREENSHOTONE_API_KEY=
APIFLASH_KEY=

# Self-hosting alternative: `npm install playwright && npx playwright install
# chromium` and the site renders phone-width captures itself, no account
# needed. Set this only if the browser lives somewhere Playwright won't find.
PLAYWRIGHT_EXECUTABLE_PATH=
